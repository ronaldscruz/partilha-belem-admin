{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "partilha-belem-admin": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": ["src/styles.css"],
            "outputPath": "dist/partilha-belem-admin"
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "partilha-belem-admin:build:development"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "8458ba25-9018-4edf-8e60-e509d7399d7d"
  }
}
